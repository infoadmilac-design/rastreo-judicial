# Copiar a notify/.env

# --- Supabase (mismas credenciales del worker) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# --- Correo (Resend: https://resend.com, gratis hasta 3.000/mes) ---
RESEND_API_KEY=re_xxxxxxxx
# Remitente. Para pruebas sirve el de Resend; en producción verifica tu dominio.
EMAIL_FROM=Rastreo Judicial <onboarding@resend.dev>
# Buzón CENTRAL que recibe todas las alertas y desde donde se reparte a los abogados.
EMAIL_CENTRAL=tu-correo-central@ejemplo.com
